{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/[...].js": {
      "regions": ["hkg1"],
      "includeFiles": "{public/**,node_modules/@libsql/linux-x64-gnu/**}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/[...]" },
    { "source": "/api/(.*)", "destination": "/api/[...]" },
    { "source": "/admin", "destination": "/api/[...]" },
    { "source": "/admin/(.*)", "destination": "/api/[...]" }
  ]
}