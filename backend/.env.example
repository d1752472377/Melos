# ===== 服务 =====
PORT=8787
HOST=127.0.0.1

# ===== 数据库（libSQL，SQLite 兼容）=====
# 单机：留空即用本地文件 data/music.db
# DB_URL=file:/abs/path/music.db
# 分布式：业务节点连中央 libSQL 服务（长期服务器上跑 sqld）
# DB_URL=http://<长期服务器IP>:8080
# DB_AUTH_TOKEN=（sqld 启用了 authToken 时填写；Turso Cloud 必填）
#
# Vercel（Serverless，文件系统只读，必须用远端库）：
#   Turso Cloud（推荐）：在 https://turso.tech 建库后
#   DB_URL=libsql://<db-name>-<org>.turso.io
#   DB_AUTH_TOKEN=<Turso 数据库 token>（必填）

# ===== 管理端鉴权（登录账号密码）=====
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_to_a_strong_password

# ===== 音源密钥加密主密钥（AES-256-GCM，32字节 hex）=====
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ===== 音源默认密钥（seed 种子数据用，可留空手动在管理后台添加）=====
KUWO_API_KEY=
KUWO_SECRET_KEY=

# ChKSz 完整音质音源（能拿到完整歌曲，替代试听片段）
CHKSZ_API_KEY=
