# ===== 服务 =====
PORT=8787
HOST=0.0.0.0

# ===== 数据库（libSQL，SQLite 兼容）=====
# 本地单机：留空即用 backend/data/music.db
# DB_URL=file:/abs/path/music.db
# 分布式/多节点：连中央 libSQL 服务（sqld / Turso Cloud）
# DB_URL=http://<host>:8080
# DB_URL=libsql://<db>-<org>.turso.io
# DB_AUTH_TOKEN=（远端库启用了认证时必填）

# ===== 会话 =====
# 登录 token 有效期（天），登出总是立即失效
# SESSION_TTL_DAYS=90
# 单个用户最多同时保持的会话数（超出时淘汰最久未活动的）
# MAX_SESSIONS_PER_USER=10

# ===== 安全 =====
# 部署在反向代理（Vercel / nginx / Caddy）之后时置 1，用于正确识别客户端 IP 限速
# TRUST_PROXY=1
# 关闭每 IP 限速（调试用，生产保持开启）
# RATE_LIMIT_DISABLED=1