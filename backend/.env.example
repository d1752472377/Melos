# ===== 服务 =====
PORT=8787
HOST=127.0.0.1

# ===== 管理端鉴权（登录账号密码）=====
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_to_a_strong_password

# ===== 音源密钥加密主密钥（AES-256-GCM，32字节 hex）=====
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ===== 音源默认密钥（seed 种子数据用，可留空手动在管理后台添加）=====
KUWO_API_KEY=
KUWO_SECRET_KEY=

# ChKSz 完整音质音源（能拿到完整歌曲，替代试听片段）
CHKSZ_API_KEY=
