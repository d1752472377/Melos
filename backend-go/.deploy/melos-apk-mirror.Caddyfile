{
	# 独立的 APK 镜像实例：不碰 1Panel 管的 openresty（80/443），
	# 单独跑在 8090 上，只做一件事——把 /var/www/apk 下的文件用 HTTP 发出去。
	admin off
	auto_https off
}

:8090 {
	# 健康检查：方便用 curl 确认服务活着
	respond /health "ok" 200

	# /apk/<file> → /var/www/apk/<file>
	# file_server 原生支持 Range，客户端断点续传就是靠它
	handle_path /apk/* {
		root * /var/www/apk
		file_server
		encode gzip
	}

	# 其他路径给一句提示，避免被当成错误配置
	respond "Melos APK mirror" 200
}
