# ===== 服务 =====
PORT=8787
HOST=0.0.0.0

# ===== 数据库（本地 SQLite）=====
# 默认 data/music.db（相对工作目录）。支持 "file:/abs/path/music.db" 或直接写路径。
# 注意：Go 版不支持远端 libsql:// / http:// 地址（启动会直接报错）。
DB_URL=file:data/music.db

# ===== 会话 =====
# 登录 token 有效期（天），登出总是立即失效
SESSION_TTL_DAYS=90
# 单个用户最多同时保持的会话数（超出时淘汰最久未活动的）
MAX_SESSIONS_PER_USER=10

# ===== 安全 =====
# 处于反向代理（nginx / Caddy）之后时设为 1，用于正确识别客户端 IP 限流
TRUST_PROXY=0
# 关闭全局限速（调试用，生产保持默认）
RATE_LIMIT_DISABLED=0
# 初始管理员（admin）默认密码（首次启动自动创建，留空默认为 12346）
ADMIN_INITIAL_PASSWORD=12346

# ===== 邮件服务（Cloudflare 自建邮件系统对接）=====
MAIL_SERVICE_URL=https://mail.dovislab.com
MAIL_ADMIN_AUTH=REDACTED
MAIL_FROM_ADDRESS=melos@dovislab.com
MAIL_FROM_NAME=Melos 音乐

# ===== APK 版本分发 =====
# APK 文件存放目录（相对工作目录）
APK_DIR=data/apk
# 单个 APK 上传体积上限（MB）
APK_MAX_MB=200
