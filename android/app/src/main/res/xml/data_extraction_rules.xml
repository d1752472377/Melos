<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 备份与迁移规则：登录态含 token，不进入云端备份与设备迁移 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="aesthetic_music_user.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="aesthetic_music_user.xml" />
    </device-transfer>
</data-extraction-rules>
