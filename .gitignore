# ---- Node.js ----
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 环境变量 / 密钥（只提交 .env.example）----
.env
*.env
!*.env.example

# ---- 部署脚本（含服务器 IP/密码，禁止上传）----
deploy/

# ---- Android / Gradle ----
android/.gradle/
android/build/
android/app/build/
**/build/
android/local.properties
android/.idea/
*.iml
*.ipr
*.iws
*.apk
*.aab
*.keystore
*.jks
# 私有签发目录：统一 keystore 与其文档均不入库（新机器接入方式联系项目所有者）
android/keystore/

# ---- Backend 运行时数据 ----
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm

# ---- music-admin 前端 ----
music-admin/node_modules/
music-admin/dist/
music-admin/.env
music-admin/.env.*
!music-admin/.env.example
music-admin/.pnpm-store/
music-admin/*.tsbuildinfo
music-admin/.refine/

# ---- 临时 / 参考目录（已从仓库移除）----
# 注意：这些规则必须锚定到仓库根（前导 /）。
# 原写法 `test/` 会匹配任意层级的同名目录，把 Android 各模块的
# `src/test/`（单元测试源码集）一并忽略——测试文件不会被提交，
# 而 CI 里 `testDebugUnitTest` 会因 NO-SOURCE 静默通过，等于没有测试。
/test/
/reference/
/research/
/音源/

# ---- 工具 / 系统 ----
# AI 助手本地工作区数据（记忆 / 日志），属于本机工具产物，不入库
.workbuddy-ai/
.agent/
.dsh-vision-toolkit/
.gopath/
.shots/
.DS_Store
Thumbs.db

# ---- Vercel CLI 本地元数据 ----
.vercel/
.env*
!**/.env.example"*.tar.gz" 
"*.tgz" 
